---
import BaseLayout from '../layouts/BaseLayout.astro';

import Map from '../components/Map';

import Item from '../components/Item.astro';

const title = 'Canberra Makerspace';
const description = 'Canberra\'s community makerspace.';
const permalink = Astro.site.href;
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">
    <div class="home-copy">
      <section class="banner">
        <div class="blurb">
          <h1><span class="emoji">👋</span>hi!</h1>
          <p>
            Welcome to Canberra Makerspace!
          </p>
          <p>
            We're a community-driven workshop for people from
            all walks of life to meet and collaborate. We provide a space for
            makers and aspiring makers to bring their ideas to life with access to
            <a href="https://github.com/makehackvoid/docs/wiki/2D-and-3D-Tools">tools</a>, 
            resources, and a supportive community.
          </p>
          <p>
            Find out <a href="#whats_on">what's on</a>, learn more about 
            <a href="/thespace">the space</a>, where to 
            <a href="#location">visit us</a> and how to 
            <a href="/membership">get involved.</a>
          </p>
          <p>
            Make, Hack, Void.
          </p>
          </div>
        <div class="main">
          <video controls autoplay muted loop>
            <source 
              src="/assets/videos/banner-extended2.mp4" 
              type="video/mp4">
          </video>
        </div>
      </section>
      <section class="blurb">
      </section>


      <section class="calendar">
        <div class="copy">
          <a class="anchor" id="whats_on"></a>
          <h1><span class="emoji">🗓️</span>what's on</h1>
          <h2>Electronics Wednesday</h2>
          <p>
            Every Wednesday from 6:30pm to 9pm-ish
          </p>
          <p>
          Activities:
          </p>
          <ul>
            <li>Electronics hacking</li>
            <li>Arduino</li>
            <li>Raspberry Pi</li>
            <li>3D printing</li>
            <li>Linux</li>
            <li>8-bit computing</li>
          </ul>
          <h2>Maker Sunday</h2>
          <p>
            Every Sunday from 1pm to 4pm-ish
          </p>
          <p>
          Activities:
          </p>
          <ul>
            <li>Woodwork</li>
            <li>Metalwork</li>
            <li>Working on cars & vans</li>
            <li>General making</li>
          </ul>
        </div>
        <div class="calendar-pane">
          <object 
            data="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Australia%2FSydney&showPrint=0&mode=AGENDA&showNav=0&showTabs=0&showCalendars=0&showDate=0&src=Y2FuYmVycmFtYWtlcnNwYWNlQGdtYWlsLmNvbQ&color=%233f51b5" 
            style="border: 0;" 
            width="100%" 
            height="100%" 
            frameborder="0" 
            scrolling="no">
          </object>
        </div>
      </section>

      <section class="location">
        <div class="copy">
          <a class="anchor" id="location"></a>
          <h1><span class="emoji">🌏</span>Where to find us</h1>
          <h2>The space's address:</h2>
          <address>
            17 Tucana Street <br />
            Giralang ACT 2617 <br />
            Canberra
          </address>
         
          <ul>
            <li>
          <a href="https://osm.org/go/uNlUbAhob">
            OpenStreetMap
          </a>
            </li>
          <li>
            <a href="https://what3words.com/ticked.sharpen.nervous">
              ///ticked.sharpen.nervous
            </a>
            </li>
            <li>
          <a href="https://maps.app.goo.gl/tDpBBhgvBFtPK6eVA">
            Google maps
          </a>
            </li>
          </ul>
        </div>
        <div class="map-container">
          <Map client:load />
        </div>
      </section>

      <section class="webring">
        <div class="canberra">
          <h1>cbr webring</h1>
          <h2>makerspaces & workshops</h2>
          <ul class="not-bulleted">
            <Item 
              place="ANU Makerspace" 
              website="https://makerspace.anu.edu.au/"></Item>
            <Item 
              place="The Recyclery"
              links=`[
                {"text": "website", "url": "https://www.canberraenvironment.org/the-recyclery"},
                {"text": "events", "url": "https://www.canberraenvironment.org/events?category=The%20Recyclery"}
              ]`>
              </Item>
            <Item place="UC Workshop7"
                  website="https://www.canberra.edu.au/future-students/study-at-uc/study-areas/design/workshop7"></Item>
            <Item place="UNSW Canberra Makerspace"></Item>
          </ul>
          <h2>community & innovation</h2>
          <ul class="not-bulleted">
            <Item 
              place="Canberra Environment Centre" 
              links=`[
                {"text": "website", "url": "https://www.canberraenvironment.org"},
                {"text": "events", "url": "https://www.canberraenvironment.org/events"}
              ]`>
              Canberra Environment Centre is a not-for-profit, non-government, environmental education centre empowering people to create a more sustainable future for the Canberra community, by supporting lifelong behavioural change. 
              </Item>
            <Item 
              place="Canberra Innovation Network" 
              links=`[
                {"text": "website", "url": "https://cbrin.com.au/"},
                {"text": "events", "url": "https://cbrin.com.au/event/"}
              ]`>
						</Item>
            <Item 
              place="Community Toolbox Canberra" 
              website="https://www.communitytoolboxcbr.org/"
              links=`[
                {"text": "website", "url": "https://www.communitytoolboxcbr.org"},
                {"text": "events", "url": "https://www.communitytoolboxcbr.org/event-calendar"},
                {"text": "inventory", "url": "https://communitytoolboxcbr.myturn.com/library/inventory/browse"}
              ]`>
              Community Toolbox Canberra is a community-led, volunteer-run tool and equipment library in Canberra, ACT, operating with the support of the local sustainability non-profit SEE Change. 
              </Item>
            <Item 
              place="SEE Change" 
              links=`[
                {"text": "website", "url": "https://seechange.org.au/"},
                {"text": "events", "url": "https://seechange.org.au/events"}
              ]`>
              SEE Change is a community-based, not-for-profit organisation that informs, inspires and supports sustainability in the Canberra region.
              </Item>
          </ul>
        </div>
        <div class="australia">
          <h1>australia webring</h1>
          <ul>
          </ul>

        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    align-items: center;
    display: flex;
    flex: 1;
    justify-content: center;
    min-height: 400px;
    gap: 2ch;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-copy {
    flex: 1;
    // padding: 0 1em;
  }

  .home-copy h1 {
    font-weight: 700;
    margin: 0.5em 0;
    line-height: 1.3;
  }
  
  .emoji {
    margin-right: 0.5ch;
  }
  
  section:not(:last-child) {
    // margin: 2em 0;
    border-bottom: 1px dashed grey;
  }

  section.banner {
    height: 70vh;
  }

  section.webring {
    display: grid;
    gap: 2ch;
    grid-template-columns: 1fr 1fr;
  }
  
  section.location, section.calendar, section.banner {
    gap: 2ch;
    display: grid;
    grid-template-rows: 100%;
    grid-template-columns: 2fr minmax(0, 3fr);
  }

  @media (max-width: 800px) {
    section.location, section.calendar, section.banner {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 650px) {
    section.location, section.calendar, section.banner {
      grid-template-columns: 1fr;
      border-bottom: none;
    }

    section.banner {
      height: auto;
      grid-template-rows: auto 70vh;
    }
    
    section.location, section.calendar {
      grid-template-rows: auto 50vh;
    }

    section.banner video, 
    section.calendar .calendar-pane,
    section.location .map-container {
      width: calc(100% + 4ch);
      margin-left: -2ch;
    }
  }

  p~ul {
    margin-top: 0;
  }

  p:has(+ ul) {
    margin-bottom: 0.5em;
  }

  .calendar-pane {
    pointer-events: none;
  }

  .map-container {
    position: relative;
    width: auto;
    // border-radius: 15px;
    overflow: hidden;
  }

  ul.not-bulleted {
    list-style-type: none;
  }

</style>
