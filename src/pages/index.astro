---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Canberra Makerspace';
const description = 'Canberra\'s community makerspace.';
const permalink = Astro.site.href;
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">
    <div class="home-copy">
      <section class="banner">
        <div class="blurb">
          <h1>welcome!</h1>
          <p>
            Canberra Makerspace is a community-driven workshop for people from
            all walks of life to meet and collaborate. We provide a space for
            makers and aspiring makers to bring their ideas to life with access to
            <a href="https://github.com/makehackvoid/docs/wiki/2D-and-3D-Tools">tools</a>, 
            resources, and a supportive community.
          </p>
          <p>
            Anyone is welcome to visit and hang out for free at our space.
            If you'd like to use our tools, you can
            <a
              href="https://square.link/u/XX0WC6Q6"
              target="_blank"
              rel="noopener noreferrer"
            >become a member</a> with a monthly payment of
            your choosing ($50 recommended). Membership fees help pay our rent
            and bills.
          </p>
          <p>
            Visit us at
            <a href="https://maps.app.goo.gl/tDpBBhgvBFtPK6eVA">
              17 Tucana Street, Giralang
            </a>.
          </p>

          <section class="opening-hours">
            <h1>opening hours</h1>
            <p><strong>Wednesdays:</strong> 6:30pm–9pm</p>
            <p><strong>Sundays:</strong> 1pm–4pm</p>
          </section>

          <section class="what-we-do">
            <a class="anchor" id="what_we_do"></a>
            <h1>what we do</h1>
            <ul>
              <li>Electronics hacking</li>
              <li>3D printing</li>
              <li>Industrial design</li>
              <li>Arduino & Raspberry Pi</li>
              <li>Linux</li>
              <li>Sewing</li>
              <li>Sculpting</li>
              <li>Jewellery</li>
              <li>Metal casting</li>
              <li>Wood turning</li>
              <li>Working on cars & bikes</li>
              <li>8-bit computing</li>
              <li>Almost anything you want!</li>
            </ul>
          </section>

          <section class="discord-community">
            <h1>Discord community</h1>
            <p>
              <a
                href="https://discord.gg/xr7yGWyPrM"
                target="_blank"
                rel="noopener noreferrer"
              >Join our Discord community</a> to see what others are working on
              or share your projects with us.
            </p>
          </section>

          <section class="contact-us">
            <h1>Contact us</h1>
            <p>
              You can email us at
              <a href="mailto:canberramakerspace@gmail.com">canberramakerspace@gmail.com</a>.
            </p>
          </section>

          <section class="supporters">
            <h1>Supporters</h1>
            <ul class="supporters-list">
              <li class="supporter">
                <img class="light" src="/assets/logos/supporters/amsa_light.svg" />
                <img class="dark" src="/assets/logos/supporters/amsa_dark.svg" />
                <div class="copy">
                  Canberra Makerspace is proud to be a community shed member of the
                  <a href="https://mensshed.org/">Australian Men's Shed Association</a>
                </div>
              </li>
              <li class="supporter">
                <img class="light" src="/assets/logos/supporters/abb_light.svg" />
                <img class="dark" src="/assets/logos/supporters/abb_dark.svg" />
                <div class="copy">
                  Canberra Makerspace's internet access is sponsored by
                  <a href="https://www.aussiebroadband.com.au/">Aussie Broadband</a>
                </div>
              </li>
            </ul>
          </section>
        </div>
        <div class="main">
          <video controls autoplay muted loop>
            <source
              src="/assets/videos/makehackvoid.mp4"
              type="video/mp4">
          </video>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    align-items: center;
    display: flex;
    flex: 1;
    justify-content: center;
    min-height: 400px;
    gap: 2ch;
  }

  video {
    border-radius: 1rem;
    display: block;
    width: 100%;
    height: auto;
  }

  .banner .main {
    padding: var(--page-gutter);
  }

  .home-copy {
    flex: 1;
    // padding: 0 1em;
  }

  .home-copy h1 {
    font-family: "Stack Sans Headline", sans-serif;
    font-weight: 500;
    margin: 0.75em 0 0.5em;
    line-height: 1.3;
  }

  .banner .blurb {
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
    padding-top: clamp(0.75rem, 2vw, 1.5rem);
  }

  .opening-hours p {
    margin: 0.4em 0;
  }

  .blurb > section {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .blurb > .supporters {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  ul.supporters-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    list-style: none;
    margin: 2em 0 0;
    padding: 0;
  }

  .supporter {
    align-items: center;
    display: grid;
    gap: 2ch;
    grid-template-columns: clamp(8rem, 20vw, 15rem) minmax(0, 1fr);
  }

  .supporter img {
    grid-column: 1;
    grid-row: 1;
    max-height: 5rem;
    max-width: 100%;
  }

  .supporter .copy {
    grid-column: 2;
    grid-row: 1;
  }

  section.banner {
    display: grid;
    gap: 2ch;
    grid-template-columns: 2fr minmax(0, 3fr);
    min-height: 70vh;
  }

  @media (min-width: 1101px) {
    .home-container {
      width: calc(40vw - var(--page-gutter));
    }

    section.banner {
      display: block;
      min-height: 0;
    }

    .banner .main {
      height: calc(100vh - var(--header-height));
      position: fixed;
      right: 0;
      top: var(--header-height);
      width: 60vw;
    }

    .banner .main video {
      height: 100%;
      object-fit: cover;
    }

  }

  @media (max-width: 1100px) {
    section.banner {
      grid-template-columns: 1fr;
    }

    .banner .main {
      grid-row: 1;
    }

    .banner .blurb {
      grid-row: 2;
      padding-top: 0;
    }
  }

  p~ul {
    margin-top: 0;
  }

  p:has(+ ul) {
    margin-bottom: 0.5em;
  }

  img.light {
    display: var(--light-theme-display);
  }

  img.dark {
    display: var(--dark-theme-display);
  }

</style>
