<button class="theme-button" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
  <svg class="moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
  </svg>
  <svg class="sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <span class="light-label">light mode</span>
  <span class="dark-label">dark mode</span>
</button>

<script>
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  let preference: string | null = null;
  try {
    preference = localStorage.getItem('theme');
  } catch {}

  function updateButton() {
    const dark = document.documentElement.dataset.theme === 'dark';
    const button = document.querySelector<HTMLButtonElement>('.theme-button');
    const action = dark ? 'Switch to light mode' : 'Switch to dark mode';
    button?.setAttribute('aria-pressed', String(dark));
    button?.setAttribute('aria-label', action);
    button?.setAttribute('title', action);
  }

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    updateButton();
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('.theme-button')) return;
    preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(preference);
    try {
      localStorage.setItem('theme', preference);
    } catch {}
  });

  systemTheme.addEventListener('change', (event) => {
    if (preference !== 'light' && preference !== 'dark') {
      applyTheme(event.matches ? 'dark' : 'light');
    }
  });

  document.addEventListener('astro:before-swap', (event) => {
    event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
  });
  document.addEventListener('astro:page-load', updateButton);
  updateButton();
</script>

<style>
  .theme-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    margin-left: auto;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: var(--text-main);
    font-family: var(--font-family-mhv);
    font-size: inherit;
    font-weight: 350;
    cursor: pointer;
  }

  .theme-button:hover {
    color: var(--primary-color);
  }

  .theme-button:focus-visible {
    outline: 2px solid var(--primary-color);
    outline-offset: 3px;
  }

  .moon,
  .dark-label {
    display: var(--light-theme-display);
  }

  .sun,
  .light-label {
    display: var(--dark-theme-display);
  }

  .theme-button span {
    white-space: nowrap;
  }
</style>
