---
import Logo from './Logo.astro'
---

<style>
  .brand {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2ch;
    
    a {
      text-decoration: none;
      box-shadow: none;
    }
  }

  h1 {
    // font-variation-settings: "opsz" 32;
    font-family: var(--font-family-brand);
    margin: 0;
    font-size: 2em;
    text-transform: lowercase;
  }

  .byline {
    font-family: var(--font-family-mhv);
    font-size: 1em;
    font-weight: 350;
  }

  @media (max-width: 520px) {
    .brand {
      gap: 0.6rem;
    }

    h1 {
      font-size: clamp(1.1rem, 4.5vw, 1.5rem);
    }

    .byline {
      font-size: 0.75rem;
    }
  }
</style>

<div class="brand">
  <Logo />
  <div>
    <a href="/">
      <h1>Canberra Makerspace</h1>
    </a>
    <span class="byline">> make hack void</span>
  </div>
</div>
